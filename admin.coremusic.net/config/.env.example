APP_ENV_MODE=development
APP_NAME=CoreMusic Admin
APP_VERSION=2.3.0
APP_TIMEZONE=Europe/Istanbul

DB_HOST=localhost                 # provider=sqlite iken DOSYA YOLU (bkz. shared/config/.env.example)
DB_ADMIN_NAME=coremusic_auth
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PROVIDER=mysql                 # mysql | mariadb | mssql | sqlite | mongodb (AdminUserRepository providerFor('admin'))

SESSION_NAME=COREMUSIC_SESS
SESSION_LIFETIME=7200
SESSION_COOKIE_DOMAIN=.coremusic.net

CSRF_TOKEN_LENGTH=32
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

TEST_MODE=false

AUTH_URL=https://auth.coremusic.net
MUSIC_URL=http://home.coremusic.net:81
ADMIN_URL=https://admin.coremusic.net

APP_PEPPER=                       # ZORUNLU: rastgele 64+ hex — .env.example GERÇEK secret TAŞIMAZ (Guardrail: Secret Yok)
