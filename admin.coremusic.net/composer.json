{
    "name": "bayramali/admin.coremusic.net",
    "description": "CoreMusic Admin Service — Subdomain (Backend Skeleton)",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../shared",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "php-di/php-di": "^7.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "coremusic/shared-infrastructure": "^2.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "vlucas/phpdotenv": "^5.7",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CoreMusic\\Admin\\": "include/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreMusic\\Admin\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform-check": false
    }
}
