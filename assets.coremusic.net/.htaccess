# CoreMusic Assets — CORS & Cache Headers
# Font, CSS, JS cross-origin erişim için

<IfModule mod_headers.c>
    # CORS — Font files (cross-origin @font-face)
    <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Range"
    </FilesMatch>

    # CORS — Image files
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # CORS — CSS files (cache: 1 saat — ?v= ile versionlanir)
    <FilesMatch "\.css$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # CORS — JS files: no-cache (2026-10-07)
    # Neden: bundler/hash yok → import'lar (main.js'in modulleri) version'siz;
    # max-age=3600 bayat modul karisimina (deploy sonrasi eski+yeni kod birlikte)
    # ve test yanilgisina yol achiyordu. no-cache = her yuklemede ETag dogrulama
    # (304 ucuz). Dogruluk > amorti edilmemis sure.
    <FilesMatch "\.js$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Cache — Static assets (1 day for CSS/JS, 1 year for immutable assets)
    <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Disable directory listing
Options -Indexes
