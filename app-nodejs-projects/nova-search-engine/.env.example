# --- AI (OpenRouter) — key .md/.log'a ASLA yazılmaz; yalnız .env ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
AI_ENABLED=true

# --- Veritabanı (Node 26 yerleşik node:sqlite + FTS5 — kurulum gerekmez) ---
DB_SQLITE_PATH=./data/novasearch.db

# --- Toplama (anti-ban) ---
# Dakikada max istek + istekler arası jitter (ms) + sayısal -s sayfa sınırı
COLLECT_RPM=12
COLLECT_MIN_DELAY_MS=1500
COLLECT_MAX_DELAY_MS=6000
COLLECT_MAX_PAGES=5
# Scroll (auto) tavanı: -s (değersiz) en fazla bu kadar sayfa çeker (YouTube continuation'ı erken bitmezse)
COLLECT_AUTO_MAX_PAGES=60

# --- Sunucu / mod ---
API_PORT=3100
API_HOST=127.0.0.1
WEB_PORT=3110
LOG_LEVEL=info
NOVA_OFFLINE=0
# youtubei.js parser gürültüsü (bilinmeyen renderer JIT dump'ları) varsayılan susturulur; 1 = göster
NOVA_YT_LOG=0
