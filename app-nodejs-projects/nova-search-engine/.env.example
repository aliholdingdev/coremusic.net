# NovaSearch AI - ornek yapilandirma (.env olarak kopyalayin)
NODE_ENV=development
LOG_LEVEL=info

# --- AI (OpenRouter free) ---
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
AI_USE_FREE_MODELS=true
AI_RATE_LIMIT_PER_MINUTE=20
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# --- Veritabani: sqlite (dev) | mysql (prod) ---
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/novasearch.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=novasearch
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false

# --- Collector (sorumlu toplama) ---
COLLECTOR_MAX_CONCURRENT=2
COLLECTOR_COOLDOWN_MS=2500
COLLECTOR_JITTER_PCT=20

# --- API ---
PORT=3001
HOST=127.0.0.1
WEB_PORT=3002
