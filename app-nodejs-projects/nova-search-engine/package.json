{
  "name": "nova-search-engine",
  "version": "0.1.0",
  "private": true,
  "description": "NovaSearch — bağımsız YouTube metadata arama motoru (parametrik CLI, AI destekli, offline-first)",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "nova": "./src/cli/main.ts"
  },
  "scripts": {
    "nova": "node src/cli/main.ts",
    "search": "node src/cli/main.ts search",
    "stats": "node src/cli/main.ts stats",
    "collect": "node src/cli/main.ts collect",
    "serve": "node src/cli/main.ts serve",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
