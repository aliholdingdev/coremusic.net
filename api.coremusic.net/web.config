<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Onarım 2026-10-24 (DevOps yüzeyi): IIS varsayılan WebDAV, DELETE/PUT
             isteklerini PHP'den önce yakalayıp 405 döndürüyordu (kanıt: 405.0
             Module=WebDAVModule / Handler=FastCGI). Route sözleşmesinde DELETE
             vardır (routes.php:268) → WebDAV module+handler kaldırılır. -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAV" />
        </handlers>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="no-referrer" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <rule name="Static files" stopProcessing="true">
                    <match url="\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$" ignoreCase="false" />
                    <action type="None" />
                </rule>
                <rule name="Block sensitive files" stopProcessing="true">
                    <match url="\.(env|log|json|lock|md|sql|sh|bak|git|ini|htpasswd|example)$" ignoreCase="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="Block private dirs" stopProcessing="true">
                    <match url="^(config|include|tests|vendor)(/.*)?$" ignoreCase="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="Passthrough" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" />
                    </conditions>
                    <action type="None" />
                </rule>
                <rule name="Rewrite to index.php" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
