# ============================================================================
# CoreMusic API Service — .env.example
# ============================================================================
# Kopyala: config/.env  (constants.php config/.env okur)
# GERÇEK SECRET YAZMA — bu dosya şablondur, versiyonlanabilir.
# ============================================================================

# --- Application ---
APP_ENV_MODE=development
APP_NAME=CoreMusic API
APP_VERSION=1.0.0
APP_TIMEZONE=Europe/Istanbul

# --- Database (uzak MySQL sunucu — localhost DEĞİL) ---
DB_HOST=DB_HOST_PLACEHOLDER
DB_NAME=coremusic_auth
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8mb4

# --- Session (Faz 0: tanımlı, API stateless) ---
SESSION_NAME=COREMUSIC_SESS
SESSION_LIFETIME=7200
SESSION_COOKIE_DOMAIN=.coremusic.net

# --- Security ---
CSRF_TOKEN_LENGTH=32
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# API key doğrulama pepper'ı (Faz 3+) — random 64-char hex string
API_KEY_PEPPER=CHANGE_ME_TO_RANDOM_64_HEX_STRING

# --- Mode Flags ---
TEST_MODE=false

# --- CORS (boş bırakılırsa cors.php varsayılan: auth.coremusic.net) ---
CORS_ALLOWED_ORIGINS=

# --- Service URLs ---
API_URL=https://api.coremusic.net
AUTH_URL=https://auth.coremusic.net
MUSIC_URL=http://home.coremusic.net:81
