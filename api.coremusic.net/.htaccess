# CoreMusic API Service — Apache Configuration
Options -Indexes
ServerSignature Off

php_flag  display_errors off
php_flag  log_errors on
php_value error_log ../../coremusic_php_errors.log

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "no-referrer"
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# .env ve yan dosyalarına erişim yasak (Guardrail: Secret Yok)
<FilesMatch "\.(env|log|lock|md|sql|sh|bak|git|ini|htpasswd|DS_Store)$">
    Require all denied
</FilesMatch>

# index.php dışındaki tüm PHP dosyalarına doğrudan erişim yasak
<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Var olan statik dosyaları olduğu gibi serve et
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # config/ ve include/ içeriği erişime kapalı
    RewriteRule ^(config|include)(/.*)?$ - [F,L]

    # Her şey front controller'a
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
