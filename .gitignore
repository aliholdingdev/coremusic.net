# ============================================
# CoreMusic — .gitignore
# ============================================

# ─── Environment & Secrets ───
.env
.env.local
.env.*.local
config/.env

# ─── Vendor (Composer) ───
vendor/
!shared/vendor/autoload.php

# ─── Node ───
node_modules/
package-lock.json
yarn.lock

# ─── Logs ───
*.log
coremusic_php_errors.log
logs/

# ─── Temp & Cache ───
.cache/
temp/
tmp/
*.tmp
*.swp
*.swo
*~

# ─── IDE ───
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Build Artifacts ───
dist/
build/
*.phar

# ─── Reference Project ───
reference-project/

# ─── WampServer ───
wampserver.log

# ─── PHPUnit ───
.phpunit.result.cache
.phpunit.cache/
coverage/
