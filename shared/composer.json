{
    "name": "coremusic/shared-infrastructure",
    "description": "CoreMusic Shared Infrastructure — Cache, Config, Database, Middleware, PageRouter, Security",
    "type": "library",
    "license": "proprietary",
    "version": "2.0.0",
    "require": {
        "php": ">=8.4",
        "ext-apcu": "*",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0",
        "psr/cache": "^3.0",
        "psr/container": "^2.0",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "CoreMusic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreMusic\\Test\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src --level=5"
    }
}
