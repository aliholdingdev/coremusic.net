# ============================================================================
# CoreMusic — Master .env.example
# ============================================================================
# Copy to each subdomain's config/.env and fill in real values.
# NEVER commit .env files to version control.
# ============================================================================

# --- Application ---
APP_ENV_MODE=development          # development | production | test
APP_NAME=CoreMusic
APP_VERSION=2.3.0
APP_TIMEZONE=Europe/Istanbul
APP_DEBUG=true                    # true in dev, false in production

# --- Mode Flags ---
TEST_MODE=false
FORCE_AUTH_BYPASS=false           # Auth bypass for local testing only; requires APP_ENV_MODE != production (ADR-008 kill: env=production => bypass always off)

# --- Default Page ---
DEFAULT_PAGE=home

# --- Database (per subdomain: set DB_NAME accordingly) ---
DB_PROVIDER=mysql                 # Global default: mysql | mariadb | mssql | sqlite | mongodb (postgresql: ŞU AN YOK, P2)
DB_HOST=localhost                 # provider=sqlite iken DOSYA YOLU olur (bkz. SQLite bölümü)
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_USER=
DB_PASSWORD=
# Subdomain-specific DB name:
DB_NAME=coremusic_user            # home -> coremusic_user | auth -> coremusic_auth

# --- Database — shared ConnectionFactory (multi-database support) ---
# Kod: CoreMusic\Database\ConnectionFactory — get($db): PDO / getOrRegister, DB başına TEK bağlantı.
# Sürücü seçimi: DB_PROVIDER_<KEY> > DB_PROVIDER > 'mysql' sırasıyla çözülür.
# Desteklenen: mysql, mariadb, mssql, sqlite, mongodb (bilinmeyen değer RuntimeException fırlatır).
# Okuma: shared/src/Config/EnvParser (.env -> $_ENV). Fail-safe: DB_{KEY}_NAME
# tanımsızsa bağlantı AÇILMAZ (DB_CONFIG_MISSING).
# Repository yüzeyi: yalnız GLOBAL DB_HOST/DB_USER/DB_PASSWORD/DB_PORT/DB_CHARSET
# okur; DB_PROVIDER seçimini getOrRegister+providerFor çözümüyle alır.
# KEY = ConnectionFactory::get($db) argümanı (strtoupper -> DB_{KEY}_NAME).
#   DISK KANITLI anahtarlar (*): subdomain container getOrRegister çağrıları
#   (auth.api.home/admin/media container + repository'ler — tek kayıt kaynağı).
#   Diğer anahtarlar (†): aynı konvansiyondan türetildi — ilk kullanan consumer esastır.
DB_AUTH_NAME=coremusic_auth         # * key: 'auth'
DB_USER_NAME=coremusic_user         # * key: 'user'
DB_MUSIC_NAME=coremusic_musics      # * key: 'music'
DB_PLAYLIST_NAME=coremusic_playlist # * key: 'playlist'
DB_SYSTEM_NAME=coremusic_system     # * key: 'system'
DB_ALBUM_NAME=coremusic_albums      # † key: 'album'
DB_CATALOG_NAME=coremusic_catalog   # † key: 'catalog'
DB_LOG_NAME=coremusic_logs          # † key: 'log'
DB_MEDIA_NAME=coremusic_media       # † key: 'media'
DB_SOCIAL_NAME=coremusic_social     # † key: 'social'
DB_WIRELESS_NAME=coremusic_wireless # † key: 'wireless'
DB_AI_NAME=coremusic_ai             # † key: 'ai'
DB_API_NAME=coremusic_api           # † key: 'api'
DB_CMS_NAME=coremusic_cms           # † key: 'cms'
DB_DOWNLOAD_NAME=coremusic_download # † key: 'download'
DB_NEVA_NAME=coremusic_neva         # † key: 'neva'
DB_STUDIO_NAME=coremusic_studio     # † key: 'studio'
DB_PATCH_NAME=coremusic_patch       # † key: 'patch'
DB_BILLING_NAME=coremusic_billing   # † key: 'billing' — abonelik/fatura (11 tablo, çekirdek-coremusic_billing.sql; onay 2026-10-30 batch #2)
DB_MEDIACATALOG_NAME=media_catalog  # * key: 'mediacatalog' — medya arşiv indeksi (ULID şema; ADR-112, onay 2026-10-30)

# --- Per-database provider overrides (optional; global DB_PROVIDER fallback) ---
# DB_PROVIDER_AUTH=mysql
# DB_PROVIDER_MUSIC=mssql
# DB_PROVIDER_SYSTEM=sqlite
# DB_PROVIDER_ANALYTICS=mongodb

# --- SQLite-specific config (offline/embedded databases, pdo_sqlite) ---
# DB_PROVIDER_SYSTEM=sqlite
# DB_SYSTEM_PATH=C:\www\coremusic.net\data\coremusic_system.sqlite  # host yerine YOL
# (Repository akışı yalnız DB_HOST okur: o zaman DB_HOST aynı SQLite yolunu taşır.)

# --- MSSQL / SQL Server example (requires pdo_sqlsrv extension) ---
# DB_PROVIDER_REPORTING=mssql
# DB_REPORTING_NAME=coremusic_reporting
# (host/port/user: global DB_HOST/DB_PORT/DB_USER/DB_PASSWORD kullanılır)

# --- MongoDB example (requires mongodb extension; execute/write fail-closed) ---
# DB_PROVIDER_ANALYTICS=mongodb
# DB_ANALYTICS_NAME=coremusic_analytics
# (host/port/auth: global DB_HOST/DB_PORT/DB_USER/DB_PASSWORD kullanılır)

# --- Live multi-DB smoke (@group live — MultiDbSmokeTest; Faz 1 1C) ---
# DDL bu anahtarla YALNIZ cm_smoke_* DB'lerine; ürün şemasına asla.
# Eksik DB_SMOKE_NAME -> canlı mysql/mssql testleri gerekçeli markTestSkipped.
DB_SMOKE_NAME=cm_smoke_probe          # * key: 'smoke' — MUST start with "cm_smoke" (test asserts prefix)
# sqlite smoke kendi temp dosyasini pin eder (DB_SMOKE_PATH test icinde uretilir).
# Per-key kimlik/host ayrismasi (ConnectionFactory: DB_{KEY}_HOST/USER/PASSWORD -> global fallback;
# mssql smoke mysql kimliginden farklidir — ayni key 'smoke' uzerinden global DB_USER bakilmaz):
#   DB_SMOKE_HOST=127.0.0.1   # mssql TDS adresi (dinamik port instance yalnizca loopback)
#   DB_SMOKE_USER=            # mssql SQL auth kimligi — DEGER YAZMA (gitignore disi rapor yok)
#   DB_SMOKE_PASSWORD=        # mssql SQL auth sifresi — DEGER YAZMA
# Port ayrismasi (ConnectionFactory::portFor: DB_{KEY}_PORT -> DB_PORT -> 3306):
#   DB_SMOKE_PORT=52513       # mssql TDS kapisi — ANAHTAR YOKSA mssql smoke gerekceli SKIP
#                             # (makine notu 2026-10-30: MSSQL17.ALI DINAMIK portta dinliyor —
#                             #  sqlservr yeniden basladiginda port degisir, yeniden dogrula;
#                             #  gecerli SQL auth kimligi de gerekli — yoksa durust FAIL)
#   DB_SMOKE_MONGO_PORT=27017 # mongodb — anahtar yoksa 27017 varsayilir
# MongoDB notu: mongodb eklentisi yoksa test duzgun skip verir (makine gercegi).

# --- Session ---
SESSION_NAME=COREMUSIC_SESS
SESSION_LIFETIME=7200             # seconds (2 hours)
SESSION_SAVE_PATH=                # leave empty for sys_get_temp_dir()
SESSION_COOKIE_DOMAIN=.coremusic.net

# --- Security ---
CSRF_TOKEN_LENGTH=32
RATE_LIMIT_MAX=60                 # requests per window
RATE_LIMIT_WINDOW=60              # seconds
APP_PEPPER=                       # REQUIRED: random 64-char hex string
TRUSTED_PROXIES=127.0.0.1,::1     # comma-separated

# --- Bypass Auth (test only — never set in production) ---
# Test bypass enabled only in development with explicit opt-in.
# DO NOT set BYPASS_* variables in production.
# BYPASS_USER_UUID=
# BYPASS_ROLE=
# BYPASS_USERNAME=

# --- Service URLs (scheme otomatik algılanır, .env ile override edilebilir) ---
# Varsayilan: HTTPS termination proxy varsa https, yoksa http kullanilir
AUTH_URL=http://auth.coremusic.net
MUSIC_URL=http://home.coremusic.net
ASSETS_URL=http://assets.coremusic.net
API_URL=http://api.coremusic.net
MEDIA_URL=http://media.coremusic.net:5000

# --- Media Service (dosya sahipliği: YALNIZ media.coremusic.net — ADR-112) ---
# Media HTTP yüzeyi port 5000 (dev: php -S); 6000 = HLS/transcode (PLANNED, kapsam dışı).
MEDIA_PORT=5000
MEDIA_ROOT=                         # medya dosya ağacı MUTLAK yolu — API/shared ASLA bu yolu istemciye vermez
# Bayt akışı: opak kısa ömürlü ticket → /media-stream/{ticket} → media:5000 (üye girişi ZORUNLU, fail-closed 401)

# --- OAuth Platform Credentials (set per platform) ---
# Pinterest
OAUTH_PINTEREST_CLIENT_ID=
OAUTH_PINTEREST_CLIENT_SECRET=

# Instagram (via Facebook Graph API)
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=

# TikTok
OAUTH_TIKTOK_CLIENT_KEY=
OAUTH_TIKTOK_CLIENT_SECRET=

# Snapchat
OAUTH_SNAPCHAT_CLIENT_ID=
OAUTH_SNAPCHAT_CLIENT_SECRET=

# YouTube (Google)
OAUTH_YOUTUBE_CLIENT_ID=
OAUTH_YOUTUBE_CLIENT_SECRET=

# Discord
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Reddit
OAUTH_REDDIT_CLIENT_ID=
OAUTH_REDDIT_CLIENT_SECRET=

# X (Twitter)
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=

# LinkedIn
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# Facebook
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# --- JWT (RS256 hybrid auth, P1-9) ---
# Bos birakilan alanlar shared/config/jwt/ default yoluna duser.
# private.pem .gitignore dadir; openssl CLI ile uretilir (genpkey RSA -out private.pem).
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=coremusic
JWT_AUDIENCE=coremusic-api
JWT_TTL_SECONDS=3600
