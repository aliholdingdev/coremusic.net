{
    "name": "coremusic/shared",
    "description": "CoreMusic Shared Package — Contracts, DTOs, Enums, Value Objects, Exceptions, Events, Validation, Security, HTTP, Helpers",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ramsey/uuid": "^4.7",
        "paragonie/sodium_compat": "^1.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CoreMusic\\Shared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreMusic\\Shared\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
