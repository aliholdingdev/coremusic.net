APP_ENV_MODE=development
APP_NAME=CoreMusic Auth
APP_VERSION=2.3.0
APP_TIMEZONE=Europe/Istanbul

DB_HOST=localhost
DB_AUTH_NAME=coremusic_auth
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8mb4

SESSION_NAME=COREMUSIC_SESS
SESSION_LIFETIME=7200
SESSION_COOKIE_DOMAIN=.coremusic.net

CSRF_TOKEN_LENGTH=32
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

TEST_MODE=false
# Auth bypass for local testing only. Requires APP_ENV_MODE != production
# (ADR-008 kill: env=production => gate closed, bypass never active). Keep false in production .env.
FORCE_AUTH_BYPASS=false
# Bypass identity — ALL THREE required, empty/missing => fail-closed (ADR-008)
BYPASS_USER_UUID=00000000000000000000000000000001
BYPASS_ROLE=test_user
BYPASS_USERNAME=test_user

AUTH_URL=https://auth.coremusic.net
MUSIC_URL=http://home.coremusic.net:81

APP_PEPPER=CHANGE_ME_TO_RANDOM_64_HEX_STRING
